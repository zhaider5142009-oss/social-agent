# ======================================================
#  SOCIAL AGENT — configuration
# ======================================================
PORT=3000

# OpenRouter key powers the deep-reasoning agent.
# Put your real key in .env (never commit it).
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY

# Planning / reasoning model (high intelligence)
AI_MODEL=openai/gpt-4o
# Fast model for replies + light content
AI_MODEL_FAST=openai/gpt-4o-mini

# How often the autonomous agent wakes up (seconds)
AGENT_CADENCE=45
# Max actions the agent is allowed in a single brain-cycle
MAX_ACTIONS_PER_CYCLE=4

# Simulation credibility
SIM_START_FOLLOWERS=1500
SIM_GROWTH_PER_POST=12
SIM_CHANCE_INBOUND=0.55

# ------------------------------------------------------------------
# Optional live credentials. Leave blank to run that platform in
# simulation mode. The connector auto-promotes to REST when a token
# is present, and to MCP when a server is configured in mcp.servers.json
# ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
X_BEARER=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
LINKEDIN_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
TIKTOK_ACCESS_TOKEN=
PATREON_ACCESS_TOKEN=
SNAPCHAT_ACCESS_TOKEN=